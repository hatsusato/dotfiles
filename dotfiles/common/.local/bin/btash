#!/usr/bin/env bash

set -euo pipefail
shopt -s extglob

# Print CLI usage to stderr and return the CLI error status.
usage() {
	cat >&2 <<'EOF'
Usage: btash [new|list|cleanup]
Attach is available from the interactive menu only.
EOF
	return 2
}

# Initialize all shared runtime state used by subcommands.
# Input:
# - XDG_RUNTIME_DIR: optional runtime directory override from the environment
# Output:
# - runtime_dir: runtime directory path in the caller's scope
# - socket_dir: btash socket directory path in the caller's scope
initialize_runtime() {
	if ! command -v dtach >/dev/null 2>&1; then
		echo "Error: dtach is required but not installed." >&2
		return 1
	fi
	if [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
		runtime_dir="${XDG_RUNTIME_DIR}"
	else
		runtime_dir="/run/user/$(id -u)"
	fi
	if [[ ! -d "${runtime_dir}" ]]; then
		echo "Error: runtime directory does not exist: ${runtime_dir}" >&2
		return 1
	fi
	socket_dir="${runtime_dir}/btash"
	mkdir -p "${socket_dir}"
}

# Print the caller's current session summary line.
print_session_summary() {
	printf '%s %s %s\n' "${session_name}" "${created_at}" "${cwd}"
}

# Append the caller's current session into options.
append_menu_option() {
	options+=("Attach: ${session_name} (${created_at}, ${cwd})")
}

# Append the caller's current socket path into socket_paths.
append_socket_path() {
	socket_paths+=("${socket_path}")
}

# Visit live socket-backed sessions.
# Args:
# - function names to invoke for each session; each can read session_name/socket_path/cwd/created_at from caller scope
emit_session_records() {
	local glob_state socket_path meta_assignments action_fn
	glob_state="$(shopt -p nullglob extglob || true)"
	shopt -s nullglob extglob
	for socket_path in "${socket_dir}"/btash-+([0-9]); do
		session_name="$(basename "${socket_path}")"
		cwd="unknown"
		created_at="00000000-000000"
		if [[ -f "${socket_path}.meta" ]]; then
			meta_assignments="$(grep -E '^declare -- (cwd|created_at)=' "${socket_path}.meta" || true)"
			[[ -n "${meta_assignments}" ]] && eval "${meta_assignments}"
		fi
		for action_fn in "${@}"; do
			"${action_fn}"
		done
	done
	eval "${glob_state}"
}

# Create a new dtach session and write its metadata file alongside the socket.
create_new_session() {
	local session_name socket_path created_at cwd
	session_name="btash-$$"
	socket_path="${socket_dir}/${session_name}"
	if [[ -e "${socket_path}" ]]; then
		echo "Error: session already exists: ${session_name}" >&2
		return 1
	fi
	created_at="$(date '+%Y%m%d-%H%M%S')"
	cwd="$(pwd)"
	declare -p cwd created_at >"${socket_path}.meta"
	trap 'rm -f "${socket_path}.meta"' RETURN
	dtach -c "${socket_path}" bash
	trap - RETURN
}

# Print sessions as "name created_at cwd" in newest-first order.
list_sessions() {
	emit_session_records print_session_summary | sort -r
}

# Return success when the caller's socket_path is stale.
is_stale_session() {
	if [[ ! -e "${socket_path}" ]]; then
		return 0
	fi
	if dtach -p "${socket_path}" >/dev/null 2>&1; then
		return 1
	fi
	return 0
}

# Delete stale session sockets and metadata.
# Args: optional prompt function name that prints yes or no.
cleanup_sessions() {
	local prompt="${1:-confirm_cleanup}"
	local -a candidates=()
	local socket_path session_name
	emit_session_records append_socket_path append_stale_candidate_record
	if [[ "${#candidates[@]}" -eq 0 ]]; then
		echo "No stale sessions found."
		return 0
	fi
	echo "Stale sessions:"
	for socket_path in "${candidates[@]}"; do
		session_name="$(basename "${socket_path}")"
		echo "  - ${session_name}"
	done
	if [[ "$(eval "${prompt}")" != "yes" ]]; then
		echo "Aborted."
		return 0
	fi
	for socket_path in "${candidates[@]}"; do
		rm -f "${socket_path}" "${socket_path}.meta"
	done
}

# Append the caller's current socket path when it is stale.
append_stale_candidate_record() {
	if is_stale_session; then
		candidates+=("${socket_path}")
	fi
}

# Ask whether stale sessions should be removed and print yes or no.
confirm_cleanup() {
	local answer
	read -r -p "Delete stale sessions? [y/N]: " answer
	if [[ "${answer}" == [yY]* ]]; then
		echo "yes"
	else
		echo "no"
	fi
}

# Attach to the caller-provided session_name.
# Input:
# - socket_path: selected socket path from the caller's scope
# Output:
# - menu_action: return or break in the caller's scope
attach_selected_session() {
	local session_name
	session_name="$(basename "${socket_path}")"
	menu_action="return"
	if is_stale_session; then
		echo "Selected session socket is missing: ${session_name}" >&2
		cleanup_sessions "echo yes"
		menu_action="break"
		return 0
	fi
	dtach -a "${socket_path}"
}

# Show the interactive selector.
show_menu() {
	local -a options socket_paths
	local session_name created_at cwd choice index menu_action socket_path
	options=("Create new session")
	socket_paths=()
	emit_session_records append_socket_path append_menu_option
	options+=("List sessions")
	options+=("Cleanup stale sessions")
	options+=("Quit")
	PS3="Select action: "
	select choice in "${options[@]}"; do
		menu_action="return"
		case "${choice:-}" in
		"" | "Quit")
			;;
		"Create new session")
			create_new_session
			;;
		"List sessions")
			list_sessions
			;;
		"Cleanup stale sessions")
			cleanup_sessions
			;;
		Attach:*)
			index=$((REPLY - 2))
			if ((index >= 0 && index < ${#socket_paths[@]})); then
				socket_path="${socket_paths[index]}"
				attach_selected_session
			else
				menu_action="break"
			fi
			;;
		*)
			echo "Invalid selection" >&2
			menu_action="break"
			;;
		esac
		if [[ "${menu_action}" != "break" ]]; then
			return 0
		fi
	done
}

# Dispatch the subcommand after initializing shared runtime state.
main() {
	local command="${1:-}"
	local runtime_dir="" socket_dir=""
	initialize_runtime
	case "${command}" in
	"")
		show_menu
		;;
	new)
		create_new_session
		;;
	list)
		list_sessions
		;;
	cleanup)
		cleanup_sessions
		;;
	*)
		usage
		;;
	esac
}

main "${@}"
