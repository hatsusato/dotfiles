#!/usr/bin/env bash
set -euo pipefail

runtime_dir=""
socket_dir=""
attach_result="attached"

usage() {
	cat >&2 <<'EOF'
Usage: btash [new|list|cleanup]
Attach is available from the interactive menu only.
EOF
}

require_dtach() {
	if ! command -v dtach >/dev/null 2>&1; then
		echo "Error: dtach is required but not installed." >&2
		return 1
	fi
}

init_runtime_paths() {
	if [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
		runtime_dir="${XDG_RUNTIME_DIR}"
	else
		local uid
		uid="$(id -u)"
		runtime_dir="/run/user/${uid}"
	fi
	socket_dir="${runtime_dir}/btash"
}

ensure_socket_dir() {
	if [[ ! -d "${runtime_dir}" ]]; then
		echo "Error: runtime directory does not exist: ${runtime_dir}" >&2
		return 1
	fi

	mkdir -p "${socket_dir}"
}

meta_path_for() {
	local socket_name="${1}"
	echo "${socket_dir}/${socket_name}.meta"
}

socket_path_for() {
	local socket_name="${1}"
	echo "${socket_dir}/${socket_name}"
}

collect_sessions() {
	[[ -d "${socket_dir}" ]] || return 0

	local nullglob_state
	nullglob_state="$(shopt -p nullglob)"
	shopt -s nullglob

	local session_record=""
	local path base name meta_path socket_path cwd created_at meta_content
	local -a session_records=()

	for path in "${socket_dir}"/btash-*; do
		base="$(basename "${path}")"
		name="${base%.meta}"
		meta_path="$(meta_path_for "${name}")"
		socket_path="$(socket_path_for "${name}")"
		cwd="unknown"
		created_at="00000000-000000"

		if [[ -f "${meta_path}" ]]; then
			# Metadata files are written with declare -p, so eval restores them.
			meta_content="$(<"${meta_path}")"
			if ! eval "${meta_content}"; then
				cwd="unknown"
				created_at="00000000-000000"
			fi
			[[ -n "${cwd}" ]] || cwd="unknown"
			[[ -n "${created_at}" ]] || created_at="00000000-000000"
		fi

		printf -v session_record '%s; %s; %s; %s; %s' \
			"$(declare -p created_at)" \
			"$(declare -p name)" \
			"$(declare -p cwd)" \
			"$(declare -p socket_path)" \
			"$(declare -p meta_path)"
		session_records+=("${session_record}")
	done
	eval "${nullglob_state}"

	printf '%s\n' "${session_records[@]}" | sort -r -u
}

create_new_session() {
	require_dtach
	ensure_socket_dir

	local session_name socket_path meta_path created_at cwd
	session_name="btash-$$"
	socket_path="${socket_dir}/${session_name}"
	meta_path="${socket_path}.meta"

	if [[ -e "${socket_path}" || -e "${meta_path}" ]]; then
		echo "Error: session already exists: ${session_name}" >&2
		return 1
	fi

	created_at="$(date '+%Y%m%d-%H%M%S')"
	cwd="$(pwd)"
	declare -p cwd created_at >"${meta_path}"

	if ! dtach -c "${socket_path}" bash; then
		rm -f "${meta_path}"
		return 1
	fi
}

list_sessions() {
	ensure_socket_dir

	local name created_at cwd session_record
	local sessions_output
	sessions_output="$(collect_sessions)"
	while IFS= read -r session_record; do
		[[ -n "${session_record}" ]] || continue
		eval "${session_record}"
		[[ -n "${name}" ]] || continue
		printf '%s %s %s\n' "${name}" "${created_at}" "${cwd}"
	done <<<"${sessions_output}"
}

gather_stale_candidates() {
	require_dtach
	ensure_socket_dir

	local name session_record
	local socket_path meta_path
	local sessions_output
	sessions_output="$(collect_sessions)"
	while IFS= read -r session_record; do
		[[ -n "${session_record}" ]] || continue
		eval "${session_record}"
		[[ -n "${name}" ]] || continue
		if [[ -e "${socket_path}" ]] && dtach -p "${socket_path}" >/dev/null 2>&1; then
			continue
		fi
		printf '%s; %s; %s\n' \
			"$(declare -p name)" \
			"$(declare -p socket_path)" \
			"$(declare -p meta_path)"
	done <<<"${sessions_output}"
}

confirm_cleanup() {
	local answer
	read -r -p "Delete stale sessions? [y/N]: " answer
	if [[ "${answer}" == "y" || "${answer}" == "Y" ]]; then
		echo "yes"
		return 0
	fi
	echo "no"
}

cleanup_sessions() {
	local prompt="${1:-yes}"
	local candidates=()
	local session_record
	local cleanup_decision
	local stale_candidates

	stale_candidates="$(
		gather_stale_candidates
	)"
	while IFS= read -r session_record; do
		[[ -n "${session_record}" ]] || continue
		candidates+=("${session_record}")
	done <<<"${stale_candidates}"

	if [[ "${#candidates[@]}" -eq 0 ]]; then
		echo "No stale sessions found."
		return 0
	fi

	echo "Stale sessions:"
	local entry name
	for entry in "${candidates[@]}"; do
		eval "${entry}"
		echo "  - ${name}"
	done

	if [[ "${prompt}" == "yes" ]]; then
		cleanup_decision="$(confirm_cleanup)"
		if [[ "${cleanup_decision}" != "yes" ]]; then
			echo "Aborted."
			return 0
		fi
	fi

	local socket_path meta_path
	for entry in "${candidates[@]}"; do
		eval "${entry}"
		rm -f "${socket_path}" "${meta_path}"
	done
}

attach_selected_session() {
	local session_name="${1}"
	local socket_path
	socket_path="$(socket_path_for "${session_name}")"
	attach_result="attached"

	if [[ ! -e "${socket_path}" ]]; then
		echo "Selected session socket is missing: ${session_name}" >&2
		cleanup_sessions "no"
		attach_result="retry"
		return 0
	fi

	dtach -a "${socket_path}"
}

show_menu() {
	require_dtach
	ensure_socket_dir

	local -a options session_names
	local name created_at cwd session_record
	local choice index session_name

	while true; do
		options=("Create new session")
		session_names=()
		local sessions_output
		sessions_output="$(
			collect_sessions
		)"
		while IFS= read -r session_record; do
			[[ -n "${session_record}" ]] || continue
			eval "${session_record}"
			[[ -n "${name}" ]] || continue
			options+=("Attach: ${name} (${created_at}, ${cwd})")
			session_names+=("${name}")
		done <<<"${sessions_output}"

		options+=("List sessions")
		options+=("Cleanup stale sessions")
		options+=("Quit")

		PS3="Select action: "
		select choice in "${options[@]}"; do
			if [[ -z "${choice:-}" ]]; then
				return 0
			fi

			case "${choice}" in
			"Create new session")
				create_new_session
				return 0
				;;
			"List sessions")
				list_sessions
				return 0
				;;
			"Cleanup stale sessions")
				cleanup_sessions "yes"
				return 0
				;;
			"Quit")
				return 0
				;;
			Attach:*)
				index=$((REPLY - 2))
				if ((index >= 0 && index < ${#session_names[@]})); then
					session_name="${session_names[index]}"
					attach_selected_session "${session_name}"
					if [[ "${attach_result}" == "retry" ]]; then
						break
					fi
					return 0
				fi
				;;
			*)
				echo "Invalid selection" >&2
				;;
			esac
		done
	done
}

main() {
	local command="${1:-}"
	init_runtime_paths
	case "${command}" in
	"")
		show_menu
		;;
	new)
		create_new_session
		;;
	list)
		list_sessions
		;;
	cleanup)
		cleanup_sessions "yes"
		;;
	*)
		usage
		return 2
		;;
	esac
}

main "${@}"
