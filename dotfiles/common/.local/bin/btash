#!/usr/bin/env bash

set -euo pipefail
shopt -s extglob

# Print CLI usage to stderr and return the CLI error status.
usage() {
	cat >&2 <<'EOF'
Usage: btash [new|list|cleanup]
Attach is available from the interactive menu only.
EOF
	return 2
}

# Initialize all shared runtime state used by subcommands.
# - Reads XDG_RUNTIME_DIR when available, otherwise falls back to /run/user/<uid>.
# - Overwrites runtime_dir in the caller's scope.
# - Overwrites socket_dir in the caller's scope.
initialize_runtime() {
	if ! command -v dtach >/dev/null 2>&1; then
		echo "Error: dtach is required but not installed." >&2
		return 1
	fi
	if [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
		runtime_dir="${XDG_RUNTIME_DIR}"
	else
		runtime_dir="/run/user/$(id -u)"
	fi
	if [[ ! -d "${runtime_dir}" ]]; then
		echo "Error: runtime directory does not exist: ${runtime_dir}" >&2
		return 1
	fi
	socket_dir="${runtime_dir}/btash"
	mkdir -p "${socket_dir}"
}

# Print the caller's current session summary line.
print_session_summary() {
	printf '%s %s %s\n' "${name}" "${created_at}" "${cwd}"
}

# Append the caller's current session record into candidates.
append_candidate_record() {
	local var record=""
	for var in created_at name cwd socket_path; do
		record+="$(declare -p "${var}")"
		record+='; '
	done
	candidates+=("${record}")
}

# Append the caller's current session into both session_names and options.
append_menu_session() {
	session_names+=("${name}")
	options+=("Attach: ${name} (${created_at}, ${cwd})")
}

# Append the caller's current session name into session_names.
append_session_name() {
	session_names+=("${name}")
}

# Visit live socket-backed sessions.
# Args:
# - action_fn: function invoked for each session and can read name/socket_path/cwd/created_at from caller scope
emit_session_records() {
	local action_fn="${1}"
	local glob_state
	local socket_path meta_assignments
	glob_state="$(shopt -p nullglob extglob || true)"
	shopt -s nullglob extglob
	for socket_path in "${socket_dir}"/btash-+([0-9]); do
		name="$(basename "${socket_path}")"
		cwd="unknown"
		created_at="00000000-000000"
		if [[ -f "${socket_path}.meta" ]]; then
			meta_assignments="$(grep -E '^declare -- (cwd|created_at)=' "${socket_path}.meta" || true)"
			[[ -n "${meta_assignments}" ]] && eval "${meta_assignments}"
		fi
		"${action_fn}"
	done
	eval "${glob_state}"
}

# Create a new dtach session and write its metadata file alongside the socket.
create_new_session() {
	local session_name socket_path created_at cwd
	session_name="btash-$$"
	socket_path="${socket_dir}/${session_name}"
	if [[ -e "${socket_path}" || -e "${socket_path}.meta" ]]; then
		echo "Error: session already exists: ${session_name}" >&2
		return 1
	fi
	created_at="$(date '+%Y%m%d-%H%M%S')"
	cwd="$(pwd)"
	declare -p cwd created_at >"${socket_path}.meta"
	if ! dtach -c "${socket_path}" bash; then
		rm -f "${socket_path}.meta"
		return 1
	fi
}

# Print sessions as "name created_at cwd" in newest-first order.
list_sessions() {
	emit_session_records print_session_summary | sort -r
}

# Return success when the caller's socket_path is stale.
is_stale_session() {
	! [[ -e "${socket_path}" ]] || ! dtach -p "${socket_path}" >/dev/null 2>&1
}

# Delete stale session sockets and metadata.
# Args: optional prompt function name that prints yes or no.
cleanup_sessions() {
	local prompt="${1:-confirm_cleanup}"
	local -a candidates=() session_names=()
	local entry name socket_path
	emit_session_records append_session_name
	for name in "${session_names[@]}"; do
		socket_path="${socket_dir}/${name}"
		if is_stale_session; then
			cwd="unknown"
			created_at="00000000-000000"
			if [[ -f "${socket_path}.meta" ]]; then
				local meta_assignments
				meta_assignments="$(grep -E '^declare -- (cwd|created_at)=' "${socket_path}.meta" || true)"
				[[ -n "${meta_assignments}" ]] && eval "${meta_assignments}"
			fi
			append_candidate_record
		fi
	done
	if [[ "${#candidates[@]}" -eq 0 ]]; then
		echo "No stale sessions found."
		return 0
	fi
	echo "Stale sessions:"
	for entry in "${candidates[@]}"; do
		eval "${entry}"
		echo "  - ${name}"
	done
	if [[ "$(eval "${prompt}")" != "yes" ]]; then
		echo "Aborted."
		return 0
	fi
	for entry in "${candidates[@]}"; do
		eval "${entry}"
		rm -f "${socket_path}" "${socket_path}.meta"
	done
}

# Ask whether stale sessions should be removed and print yes or no.
confirm_cleanup() {
	local answer
	read -r -p "Delete stale sessions? [y/N]: " answer
	if [[ "${answer}" == [yY]* ]]; then
		echo "yes"
	else
		echo "no"
	fi
}

# Attach to the caller-provided session_name.
# Input:
# - session_name: selected session name from the caller's scope
# - socket_dir: session root from the caller's scope
# - socket_path: derived from session_name in the caller's scope
# Output:
# - menu_action: return or break in the caller's scope
attach_selected_session() {
	socket_path="${socket_dir}/${session_name}"
	menu_action="return"
	if is_stale_session; then
		echo "Selected session socket is missing: ${session_name}" >&2
		cleanup_sessions "echo yes"
		menu_action="break"
		return 0
	fi
	dtach -a "${socket_path}"
}

# Show the interactive selector.
show_menu() {
	local -a options session_names
	local name created_at cwd choice index session_name menu_action socket_path
	while true; do
		options=("Create new session")
		session_names=()
		emit_session_records append_menu_session
		options+=("List sessions")
		options+=("Cleanup stale sessions")
		options+=("Quit")
		PS3="Select action: "
		select choice in "${options[@]}"; do
			menu_action="return"
			case "${choice:-}" in
			"" | "Quit")
				;;
			"Create new session")
				create_new_session
				;;
			"List sessions")
				list_sessions
				;;
			"Cleanup stale sessions")
				cleanup_sessions confirm_cleanup
				;;
			Attach:*)
				index=$((REPLY - 2))
				if ((index >= 0 && index < ${#session_names[@]})); then
					session_name="${session_names[index]}"
					attach_selected_session
				else
					menu_action="break"
				fi
				;;
			*)
				echo "Invalid selection" >&2
				menu_action="break"
				;;
			esac
			if [[ "${menu_action}" != "break" ]]; then
				return 0
			fi
			break
		done
	done
}

# Dispatch the subcommand after initializing shared runtime state.
main() {
	local command="${1:-}"
	local runtime_dir="" socket_dir=""
	initialize_runtime
	case "${command}" in
	"")
		show_menu
		;;
	new)
		create_new_session
		;;
	list)
		list_sessions
		;;
	cleanup)
		cleanup_sessions confirm_cleanup
		;;
	*)
		usage
		;;
	esac
}

main "${@}"
