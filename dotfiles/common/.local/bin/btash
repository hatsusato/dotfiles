#!/usr/bin/env bash
set -euo pipefail

usage() {
	cat >&2 <<'EOF'
Usage: btash [new|list|cleanup]
Attach is available from the interactive menu only.
EOF
}

require_dtach() {
	if ! command -v dtach >/dev/null 2>&1; then
		echo "Error: dtach is required but not installed." >&2
		return 1
	fi
}

init_runtime_dir() {
	if [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
		runtime_dir="${XDG_RUNTIME_DIR}"
	else
		local uid
		uid="$(id -u)"
		runtime_dir="/run/user/${uid}"
	fi
}

ensure_socket_dir() {
	if [[ ! -d "${runtime_dir}" ]]; then
		echo "Error: runtime directory does not exist: ${runtime_dir}" >&2
		return 1
	fi

	mkdir -p "${socket_dir}"
}

collect_sessions() {
	[[ -d "${socket_dir}" ]] || return 0

	local nullglob_state="shopt -u nullglob"
	if shopt -q nullglob; then
		nullglob_state="shopt -s nullglob"
	fi
	shopt -s nullglob

	local path base name meta_path socket_path cwd created_at meta_assignments

	for path in "${socket_dir}"/btash-*; do
		base="$(basename "${path}")"
		[[ "${base}" =~ ^btash-[0-9]+(\.meta)?$ ]] || continue

		name="${base%.meta}"
		socket_path="${socket_dir}/${name}"
		meta_path="${socket_dir}/${name}.meta"
		cwd=""
		created_at=""

		if [[ -f "${meta_path}" ]]; then
			meta_assignments="$(grep -E '^declare -- (cwd|created_at)=' "${meta_path}" || true)"
			[[ -n "${meta_assignments}" ]] && eval "${meta_assignments}"
		fi
		: "${cwd:=unknown}"
		: "${created_at:=00000000-000000}"

		printf '%s; %s; %s; %s; %s\n' "$(declare -p created_at)" "$(declare -p name)" "$(declare -p cwd)" "$(declare -p socket_path)" "$(declare -p meta_path)"
	done | sort -r -u

	eval "${nullglob_state}"
}

create_new_session() {
	local session_name socket_path meta_path created_at cwd
	session_name="btash-$$"
	socket_path="${socket_dir}/${session_name}"
	meta_path="${socket_path}.meta"

	if [[ -e "${socket_path}" || -e "${meta_path}" ]]; then
		echo "Error: session already exists: ${session_name}" >&2
		return 1
	fi

	created_at="$(date '+%Y%m%d-%H%M%S')"
	cwd="$(pwd)"
	declare -p cwd created_at >"${meta_path}"

	if ! dtach -c "${socket_path}" bash; then
		rm -f "${meta_path}"
		return 1
	fi
}

list_sessions() {
	local name created_at cwd session_record

	while IFS= read -r session_record; do
		[[ -n "${session_record}" ]] || continue
		eval "${session_record}"
		[[ -n "${name}" ]] || continue
		printf '%s %s %s\n' "${name}" "${created_at}" "${cwd}"
	done < <(collect_sessions)
}

gather_stale_candidates() {
	local name socket_path meta_path session_record

	while IFS= read -r session_record; do
		[[ -n "${session_record}" ]] || continue
		eval "${session_record}"
		[[ -n "${name}" ]] || continue

		if [[ -e "${socket_path}" ]] && dtach -p "${socket_path}" >/dev/null 2>&1; then
			continue
		fi

		printf '%s; %s; %s\n' "$(declare -p name)" "$(declare -p socket_path)" "$(declare -p meta_path)"
	done < <(collect_sessions)
}

confirm_cleanup() {
	local answer
	read -r -p "Delete stale sessions? [y/N]: " answer

	if [[ "${answer}" == "y" || "${answer}" == "Y" ]]; then
		echo "yes"
		return 0
	fi

	echo "no"
}

always_yes() {
	echo "yes"
}

cleanup_sessions() {
	local prompt="${1:-confirm_cleanup}"
	local -a candidates=()
	local session_record entry name socket_path meta_path

	while IFS= read -r session_record; do
		[[ -n "${session_record}" ]] || continue
		candidates+=("${session_record}")
	done < <(gather_stale_candidates)

	if [[ "${#candidates[@]}" -eq 0 ]]; then
		echo "No stale sessions found."
		return 0
	fi

	echo "Stale sessions:"
	for entry in "${candidates[@]}"; do
		eval "${entry}"
		echo "  - ${name}"
	done

	if [[ "$("${prompt}")" != "yes" ]]; then
		echo "Aborted."
		return 0
	fi

	for entry in "${candidates[@]}"; do
		eval "${entry}"
		rm -f "${socket_path}" "${meta_path}"
	done
}

attach_selected_session() {
	local session_name="${1}"
	local socket_path="${socket_dir}/${session_name}"

	attach_result="attached"
	if [[ ! -e "${socket_path}" ]]; then
		echo "Selected session socket is missing: ${session_name}" >&2
		cleanup_sessions always_yes
		attach_result="retry"
		return 0
	fi

	dtach -a "${socket_path}"
}

show_menu() {
	local -a options session_names
	local name created_at cwd session_record choice index session_name

	while true; do
		options=("Create new session")
		session_names=()

		while IFS= read -r session_record; do
			[[ -n "${session_record}" ]] || continue
			eval "${session_record}"
			[[ -n "${name}" ]] || continue
			options+=("Attach: ${name} (${created_at}, ${cwd})")
			session_names+=("${name}")
		done < <(collect_sessions)

		options+=("List sessions")
		options+=("Cleanup stale sessions")
		options+=("Quit")

		PS3="Select action: "
		select choice in "${options[@]}"; do
			case "${choice:-}" in
			"") return 0 ;;
			"Create new session")
				create_new_session
				return 0
				;;
			"List sessions")
				list_sessions
				return 0
				;;
			"Cleanup stale sessions")
				cleanup_sessions confirm_cleanup
				return 0
				;;
			"Quit")
				return 0
				;;
			Attach:*)
				index=$((REPLY - 2))
				if ((index >= 0 && index < ${#session_names[@]})); then
					session_name="${session_names[index]}"
					attach_selected_session "${session_name}"
					if [[ "${attach_result}" == "retry" ]]; then
						break
					fi
					return 0
				fi
				;;
			*)
				echo "Invalid selection" >&2
				;;
			esac
		done
	done
}

main() {
	local command="${1:-}"
	local runtime_dir="" socket_dir="" attach_result="attached"

	init_runtime_dir
	socket_dir="${runtime_dir}/btash"

	case "${command}" in
	"" | new | list | cleanup)
		require_dtach
		ensure_socket_dir
		;;
	esac

	case "${command}" in
	"")
		show_menu
		;;
	new)
		create_new_session
		;;
	list)
		list_sessions
		;;
	cleanup)
		cleanup_sessions confirm_cleanup
		;;
	*)
		usage
		return 2
		;;
	esac
}

main "${@}"
